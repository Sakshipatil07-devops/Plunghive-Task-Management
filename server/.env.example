# Copy to .env and fill in to enable real AWS calls.
# Without these, the app still runs fully — AWS-backed features
# (uploads, notifications, cloud logging) just no-op and log locally.

PORT=4000

# Secret used to sign login sessions (JWT). Has a dev fallback, but set a
# real random value before deploying anywhere shared.
JWT_SECRET=

# --- AWS (all optional; leave blank to run in local-only mode) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket for task attachments (create manually or via `terraform apply` in infra/)
S3_BUCKET_NAME=

# SNS topic ARN that task events are published to
SNS_TOPIC_ARN=

# SQS queue URL subscribed to the SNS topic, consumed by the worker
SQS_QUEUE_URL=

# CloudWatch Logs group/stream for app logs
CLOUDWATCH_LOG_GROUP=/pluginhive-taskmanager/app
CLOUDWATCH_LOG_STREAM=local-dev
